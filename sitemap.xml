let currentTeamIndex = 0;

function renderTeamCarousel() {
  const track = document.getElementById("teamTrack");
  if (!track) return;

  track.innerHTML = teamMembers.map((member, index) => {
    const isActive = index === currentTeamIndex ? "active" : "";
    return `
      <div class="team-card ${isActive}">
        <div class="team-img-frame">
          <img 
            src="${member.image}" 
            alt="${member.name}" 
            loading="lazy"
            onerror="this.onerror=null; this.src='https://via.placeholder.com/200?text=Tobadem+Team';"
          />
        </div>
        <div class="team-info">
          <h3>${member.name}</h3>
          <p>${member.designation}</p>
        </div>
      </div>
    `;
  }).join('');
}

function rotateTeamCarousel(direction = 1) {
